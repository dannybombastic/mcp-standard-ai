# AI Context Manager MCP - Variables de entorno
# Copia este archivo como .env y rellena los valores (NO commitear .env)

# URL base de la aplicación cloud
AI_CONTEXT_MANAGER_BASE_URL=https://cloud.example.com

# Token personal (PAT) creado en la web - NUNCA commitear este valor
AI_CONTEXT_MANAGER_TOKEN=pat_xxx

# Opcional: modo de storage por defecto (workspace | global)
# AI_CONTEXT_MANAGER_STORAGE_MODE=workspace

# Opcional: nivel de log (DEBUG | INFO | WARNING | ERROR)
# AI_CONTEXT_MANAGER_LOG_LEVEL=INFO
